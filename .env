# Umami analytics (public/index.html, src/analytics.js).
#
# Production values. The tracker only sends from hostnames listed in
# REACT_APP_UMAMI_DOMAINS, so local builds and Azure preview deploys send
# nothing. To test against the "Scoring Trainer (test)" website instead,
# override both at build time:
#
#   REACT_APP_UMAMI_WEBSITE_ID=199c41e8-d03f-46c7-be42-d69ab3c54a5a \
#   REACT_APP_UMAMI_DOMAINS=localhost,127.0.0.1 npm run build
REACT_APP_UMAMI_WEBSITE_ID=c53f7ab3-97f3-4b9f-bddf-f46aa3835cc8
REACT_APP_UMAMI_DOMAINS=scoringtrainer.konbamwa.net

# Release ID sent as the app_version session property and data-release.
# `npm run build` replaces it with the short commit SHA (scripts/build.js).
REACT_APP_VERSION=dev
